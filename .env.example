# Family Cash Flow local development settings

APP_ENV=local
APP_NAME=Family Cash Flow
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=family_cash_flow
POSTGRES_USER=family_cash_flow
POSTGRES_PASSWORD=family_cash_flow_dev

DATABASE_URL=postgresql+psycopg://family_cash_flow:family_cash_flow_dev@localhost:5433/family_cash_flow

JWT_SECRET_KEY=change-me-in-local-env
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_DEFAULT_FAMILY_ID=
TELEGRAM_DEFAULT_ACCOUNT_ID=
